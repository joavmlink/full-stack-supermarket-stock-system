# Copy to backend/.env for local development. Every variable is optional
# locally; an empty value (VAR=) counts as not set.

# development | test | production. Production requires DATABASE_URL.
NODE_ENV=development

# HTTP port of the API. 0 lets the operating system pick a free port.
PORT=3000

# Postgres connection string (postgres:// or postgresql://). Leave empty to use
# the embedded PGlite database. In production use the Neon *pooled* URL.
# It is a secret: never commit it. In Vercel it is a Sensitive variable.
DATABASE_URL=

# PGlite data directory when DATABASE_URL is empty. Defaults to ./data in
# development (gitignored) and to memory otherwise.
PGLITE_DATA_DIR=

# Comma-separated list of exact origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Absolute lifetime of a login session, in hours.
SESSION_TTL_HOURS=12

# Rate limits. Reads are counted in memory per instance; writes and failed
# logins are counted in Postgres and shared by every instance.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=300
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_LOGIN_WINDOW_MS=900000
# Failed logins per client IP, and per account from any IP.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_MAX=100

# Have I Been Pwned "Pwned Passwords" range API. Every new password (employee
# created, password changed, create-admin CLI) is checked against it; only the
# first 5 characters of its SHA-1 hash are sent (k-anonymity). The check cannot
# be turned off; if the service is unreachable it is skipped and logged.
PWNED_PASSWORDS_URL=https://api.pwnedpasswords.com
